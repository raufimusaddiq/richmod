# Example only. Copy to the untracked wrangler.toml before deploying; see
# ../cloudflare-email-ingress/README.md and docs/runbooks/cloudflare-email-ingress.md.
#
# Secret (never put it in this file):
#   wrangler secret put RICHMOD_INGRESS_SECRET
# Its value must be the same literal string as EMAIL_INGRESS_HMAC_SECRET in the
# Richmod API environment (see .env.example).
name = "richmod-email-delivery-worker"
main = "src/index.js"
compatibility_date = "2026-09-04"

[vars]
# Replace with your own Richmod API origin; the path is fixed.
RICHMOD_INGRESS_URL = "https://api.example.com/finance/v1/email/inbond"

[[r2_buckets]]
binding = "RICHMOD_EMAIL_RAW"
bucket_name = "richmod-email-raw"

[[queues.consumers]]
queue = "richmod-email-delivery"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 5
dead_letter_queue = "richmod-email-delivery-dlq"
