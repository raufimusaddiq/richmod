# Include this site block in the host-managed Caddyfile.
# finance-api is the only upstream: the Go binary serves both the API and the
# embedded static frontend. Caddy must not set Cache-Control; the Go handler
# owns the per-route cache classes. After editing the host Caddyfile, reload
# Caddy (for example: docker exec idx-caddy caddy reload --config /etc/caddy/Caddyfile).
finance.investdx.biz.id {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}

	handle {
		request_body {
			max_size 12MB
		}
		reverse_proxy finance-api:8080
	}

	log {
		output file /var/log/caddy/finance-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
