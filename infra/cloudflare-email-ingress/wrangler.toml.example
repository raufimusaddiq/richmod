# Example only. Copy to the untracked wrangler.toml before deploying; see
# README.md in this folder and docs/runbooks/cloudflare-email-ingress.md.
# The R2 bucket and the Queue below must already exist in your Cloudflare account.
# This Worker holds no secret: it stores the raw message in R2 and enqueues metadata.
name = "richmod-email-ingress"
main = "src/index.js"
compatibility_date = "2026-09-04"

[[r2_buckets]]
binding = "RICHMOD_EMAIL_RAW"
bucket_name = "richmod-email-raw"

[[queues.producers]]
binding = "RICHMOD_EMAIL_DELIVERY"
queue = "richmod-email-delivery"
