# Copy to .env and replace every placeholder before starting the stack.
# Never commit .env. Production keeps its values in the host-managed finance.env
# and GitHub Environment secrets, not in this file.
#
# Sections: database · API and web · LLM gateway · Telegram · email ingress ·
# document and evidence storage · judgment plane · document interpretation ·
# auto-confirm · backups. Every variable below is read by the code or passed
# through by compose.yaml.

# --- Database ----------------------------------------------------------------
POSTGRES_DB=family_finance
POSTGRES_USER=family_finance
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://family_finance:replace-with-a-long-random-password@db:5432/family_finance?sslmode=disable

# --- API and web -------------------------------------------------------------
API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes

# --- LLM gateway (LiteRouter only; Richmod never holds upstream provider keys) -
LLM_GATEWAY_BASE_URL=http://9router:20128/v1
LLM_GATEWAY_API_KEY=replace-with-gateway-api-key
LLM_GATEWAY_PROTOCOL=responses
LLM_MODEL_TELEGRAM_EXTRACT=ocg/gpt-5.6-luna
LLM_MODEL_BANK_EXTRACT=finance-tracker
LLM_MODEL_DOCUMENT_VISION=ocg/gpt-5.6-luna
LLM_MODEL_INSIGHTS=primary
# Optional. Model for financial-provider email extraction. When empty, the worker
# reuses LLM_MODEL_BANK_EXTRACT.
LLM_MODEL_FINANCIAL_EMAIL=

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=replace-with-bot-username-without-at-sign
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret

# --- Email ingress (Cloudflare transport; see docs/runbooks/cloudflare-email-ingress.md) -
# Must be the same literal value as RICHMOD_INGRESS_SECRET on the delivery Worker.
EMAIL_INGRESS_HMAC_SECRET=replace-with-a-long-random-ingress-secret
EMAIL_INGRESS_DOMAIN=richmod.link
# Set only after a real forwarded .eml proves authserv-id + DKIM/DMARC/ARC behavior.
EMAIL_INGRESS_TRUSTED_AUTHSERV_IDS=

# --- Document and evidence storage -------------------------------------------
DOCUMENT_STORAGE_PATH=/var/lib/finance/attachments
OSS_ENDPOINT=https://s3-compatible.example.com
OSS_REGION=example-region
OSS_BUCKET=private-richmod-bucket
OSS_PREFIX=richmod
OSS_ACCESS_KEY=replace-with-storage-access-key
OSS_SECRET_KEY=replace-with-storage-secret-key

# --- Judgment plane: bounded semantic decisions (ADR-038) --------------------
# The worker requires JUDGMENT_MODEL in production. A non-production environment
# can opt out explicitly with JUDGMENT_MODE=disabled-dev; leave JUDGMENT_MODE
# empty everywhere else.
JUDGMENT_MODEL=typesafe/jev-latest
JUDGMENT_TIMEOUT_MS=3000
JUDGMENT_MODE=

# --- Document interpretation rollout (ADR-037) -------------------------------
# legacy (the default) keeps the classify-then-extract pipeline. shadow also runs
# the unified interpretation call without acting on it. primary is reserved and
# keeps the legacy pipeline until its gates are complete. Any unknown value means
# legacy.
RICHMOD_DOCUMENT_INTERPRETATION=

# --- Per-source auto-confirm kill-switches (PRD 33) --------------------------
# Only an explicit negative value (0/false/off/no/disabled) parks that source in
# review; any other value, including 1 or true, keeps auto-confirm on, independent
# of the other sources.
RICHMOD_AUTOCONFIRM_BANK_CATEGORY=
RICHMOD_AUTOCONFIRM_RECEIPT=
RICHMOD_AUTOCONFIRM_SCREENSHOT=
RICHMOD_AUTOCONFIRM_TELEGRAM=

# --- Backups (restic) --------------------------------------------------------
# Production compose derives the encrypted restic repository from OSS_* under
# OSS_PREFIX/backups/restic. This local value remains useful for development drills.
RESTIC_REPOSITORY=/repository
RESTIC_PASSWORD_FILE=/run/secrets/restic-password
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
