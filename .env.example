# Copy to .env and replace every placeholder before starting the stack.
POSTGRES_DB=family_finance
POSTGRES_USER=family_finance
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://family_finance:replace-with-a-long-random-password@db:5432/family_finance?sslmode=disable

API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
