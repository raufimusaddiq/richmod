# Copy to .env and replace every placeholder before starting the stack.
POSTGRES_DB=family_finance
POSTGRES_USER=family_finance
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://family_finance:replace-with-a-long-random-password@db:5432/family_finance?sslmode=disable

API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
LLM_GATEWAY_BASE_URL=http://9router:20128/v1
LLM_GATEWAY_API_KEY=replace-with-gateway-api-key
LLM_MODEL_TELEGRAM_EXTRACT=ocg/gpt-5.6-luna
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
GMAIL_OAUTH_CLIENT_PATH=
GMAIL_MAILBOX=mailbox@example.com
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
