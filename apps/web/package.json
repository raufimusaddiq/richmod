{
  "name": "family-finance-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/build-id.mjs",
    "build": "node scripts/build-id.mjs && next build",
    "build:embed": "npm run build && node scripts/sync-embed.mjs",
    "start": "node scripts/static-server.mjs",
    "pretest": "node scripts/build-id.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:motion": "node scripts/motion-one-shot-smoke.mjs",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:visual:update": "UPDATE_VISUAL_BASELINES=1 node scripts/visual-smoke.mjs",
    "capture:readme": "node scripts/capture-readme.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
