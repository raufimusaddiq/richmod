{
  "name": "family-finance-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build": "bun scripts/build.mjs",
    "build:embed": "bun run build && bun scripts/sync-embed.mjs",
    "start": "bun scripts/static-server.mjs",
    "test": "bun test tests/",
    "test:e2e": "bun run build && playwright test",
    "test:visual": "sh scripts/visual-docker.sh",
    "test:visual:update": "sh scripts/visual-docker.sh --update",
    "capture:readme": "node scripts/capture-readme.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "playwright": "1.65.0"
  }
}
